{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "hugo --minify --gc",
  "outputDirectory": "public",
  "framework": null,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/style.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
